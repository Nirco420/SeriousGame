digraph UML {
graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.5", ranksep="1.2", splines=polyline, outputorder=edgesfirst];
node [shape=plain];
edge [fontname="Arial", fontsize=10, color="#64748b", fontcolor="#334155", arrowsize=0.8];
"MainStorrage" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#64748b"><TR><TD BGCOLOR="#fef3c7"><FONT FACE="Arial" POINT-SIZE="10">MonoBehaviour</FONT><BR/><FONT FACE="Arial" POINT-SIZE="15"><B>MainStorrage</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">+ wood : int [property]<BR ALIGN="LEFT"/>+ wheed : int [property]<BR ALIGN="LEFT"/>+ flachs : int [property]<BR ALIGN="LEFT"/>+ gold : int [property]<BR ALIGN="LEFT"/>- startWood : int<BR ALIGN="LEFT"/>- startWheed : int<BR ALIGN="LEFT"/>- startFlachs : int<BR ALIGN="LEFT"/>- startGold : int<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">+ Start() : void<BR ALIGN="LEFT"/>+ AddResources(int amount, ResourceData resource) : void<BR ALIGN="LEFT"/>+ RemoveResource(int amount, ResourceData resource) : void<BR ALIGN="LEFT"/>+ HasResources(int amount, ResourceData resource) : bool<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"DemendManger" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#64748b"><TR><TD BGCOLOR="#fce7f3"><FONT FACE="Arial" POINT-SIZE="10">MonoBehaviour</FONT><BR/><FONT FACE="Arial" POINT-SIZE="15"><B>DemendManger</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">+ OnDemandDisplayRequested : Action&lt;DemandData, int&gt; [event]<BR ALIGN="LEFT"/>+ OnDemandCompleted : Action [event]<BR ALIGN="LEFT"/>- demands : List&lt;DemandData&gt;<BR ALIGN="LEFT"/>- mainStorrage : MainStorrage<BR ALIGN="LEFT"/>- barometerManager : BarometerManager<BR ALIGN="LEFT"/>- currentDemend : DemandData<BR ALIGN="LEFT"/>- nextDemandIndex : int<BR ALIGN="LEFT"/>- dueRound : int<BR ALIGN="LEFT"/>- latestRound : int<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">+ TriggerDemand(DemandData demand, int currentRound) : void<BR ALIGN="LEFT"/>+ CheckDemandsForRound(int currentRound) : void<BR ALIGN="LEFT"/>+ GiveAll() : void<BR ALIGN="LEFT"/>+ GiveHalf() : void<BR ALIGN="LEFT"/>+ MoreTime() : void<BR ALIGN="LEFT"/>+ HasActiveDemand() : bool<BR ALIGN="LEFT"/>+ CanGiveAll() : bool<BR ALIGN="LEFT"/>+ CanGiveHalf() : bool<BR ALIGN="LEFT"/>- CompleteDemand() : void<BR ALIGN="LEFT"/>+ GetRemainingRounds() : int<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"RoundManager" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#64748b"><TR><TD BGCOLOR="#e0f2fe"><FONT FACE="Arial" POINT-SIZE="10">MonoBehaviour</FONT><BR/><FONT FACE="Arial" POINT-SIZE="15"><B>RoundManager</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">- ui : BuildingUI<BR ALIGN="LEFT"/>- storages : List&lt;SegmentStorage&gt;<BR ALIGN="LEFT"/>- demendManger : DemendManger<BR ALIGN="LEFT"/>+ currentRound : int [property]<BR ALIGN="LEFT"/>- transports : List&lt;TransportManager&gt;<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">- OnEnable() : void<BR ALIGN="LEFT"/>+ StartNextRound(bool isRoundFinished) : void<BR ALIGN="LEFT"/>- OnDisable() : void<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"DemandData" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#64748b"><TR><TD BGCOLOR="#ede9fe"><FONT FACE="Arial" POINT-SIZE="10">ScriptableObject</FONT><BR/><FONT FACE="Arial" POINT-SIZE="15"><B>DemandData</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">+ name : string<BR ALIGN="LEFT"/>+ description : string<BR ALIGN="LEFT"/>+ resource : ResourceData<BR ALIGN="LEFT"/>+ quantity : int<BR ALIGN="LEFT"/>+ triggerRound : int<BR ALIGN="LEFT"/>+ deadline : int<BR ALIGN="LEFT"/>+ deferralPeriod : int<BR ALIGN="LEFT"/>+ changeInValuePositive : int<BR ALIGN="LEFT"/>+ changeInValueHalf : int<BR ALIGN="LEFT"/>+ changeInValueNegative : int<BR ALIGN="LEFT"/>+ changeInDeferalInValue : int<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"ResourceData" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#64748b"><TR><TD BGCOLOR="#ede9fe"><FONT FACE="Arial" POINT-SIZE="10">ScriptableObject</FONT><BR/><FONT FACE="Arial" POINT-SIZE="15"><B>ResourceData</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">+ resourceType : ResourceType<BR ALIGN="LEFT"/>+ name : string<BR ALIGN="LEFT"/>+ icon : Sprite<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"BarometerManager" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#64748b"><TR><TD BGCOLOR="#fce7f3"><FONT FACE="Arial" POINT-SIZE="10">MonoBehaviour</FONT><BR/><FONT FACE="Arial" POINT-SIZE="15"><B>BarometerManager</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">- cellSize : float<BR ALIGN="LEFT"/>- circle : RectTransform<BR ALIGN="LEFT"/>- middlePosition : Vector2<BR ALIGN="LEFT"/>- duration : float<BR ALIGN="LEFT"/>- isGameOver : bool<BR ALIGN="LEFT"/>- currentValue : int<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">+ Awake() : void<BR ALIGN="LEFT"/>+ UpdateBarometer() : void<BR ALIGN="LEFT"/>+ MoveCircle() : IEnumerator<BR ALIGN="LEFT"/>+ ChangeValue(int amount) : void<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"DemandEntryUI" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#64748b"><TR><TD BGCOLOR="#fce7f3"><FONT FACE="Arial" POINT-SIZE="10">MonoBehaviour</FONT><BR/><FONT FACE="Arial" POINT-SIZE="15"><B>DemandEntryUI</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">- demandResource : TextMeshProUGUI<BR ALIGN="LEFT"/>- demandTitle : TextMeshProUGUI<BR ALIGN="LEFT"/>- quanatityText : TextMeshProUGUI<BR ALIGN="LEFT"/>- remainingRoundsLeft : TextMeshProUGUI<BR ALIGN="LEFT"/>- giveAll : Button<BR ALIGN="LEFT"/>- giveHalf : Button<BR ALIGN="LEFT"/>- aufschub : Button<BR ALIGN="LEFT"/>- demandManager : DemendManger<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">+ Setup(DemandData currentDemand, int remainingRounds, DemendManger<BR ALIGN="LEFT"/>manager) : void<BR ALIGN="LEFT"/>- Update() : void<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"DemendUI" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#64748b"><TR><TD BGCOLOR="#fce7f3"><FONT FACE="Arial" POINT-SIZE="10">MonoBehaviour</FONT><BR/><FONT FACE="Arial" POINT-SIZE="15"><B>DemendUI</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">- demendManger : DemendManger<BR ALIGN="LEFT"/>- demandPanel : GameObject<BR ALIGN="LEFT"/>- headlineText : TextMeshProUGUI<BR ALIGN="LEFT"/>- descriptionText : TextMeshProUGUI<BR ALIGN="LEFT"/>- resourceName : TextMeshProUGUI<BR ALIGN="LEFT"/>- demandQuantity : TextMeshProUGUI<BR ALIGN="LEFT"/>- demandDeadline : TextMeshProUGUI<BR ALIGN="LEFT"/>- closeButton : Button<BR ALIGN="LEFT"/>- openDemandEntry : Button<BR ALIGN="LEFT"/>- demandEntryUI : DemandEntryUI<BR ALIGN="LEFT"/>- content : Transform<BR ALIGN="LEFT"/>- redInfo : GameObject<BR ALIGN="LEFT"/>- demandOverview : GameObject<BR ALIGN="LEFT"/>- demandData : DemandData<BR ALIGN="LEFT"/>- resourceData : ResourceData<BR ALIGN="LEFT"/>- demandEntry : DemandEntryUI<BR ALIGN="LEFT"/>- currentState : bool<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">- OnEnable() : void<BR ALIGN="LEFT"/>+ Start() : void<BR ALIGN="LEFT"/>+ DemandPopUP(DemandData currentDemand, int currentRound) : void<BR ALIGN="LEFT"/>+ ClosePopUp() : void<BR ALIGN="LEFT"/>+ OpenDemandOverview() : void<BR ALIGN="LEFT"/>- RemoveDemandEntry() : void<BR ALIGN="LEFT"/>- OnDisable() : void<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"DemendManger" -> "MainStorrage" [label="mainStorrage",arrowhead=vee];
"DemendManger" -> "DemandData" [label="demands",arrowhead=vee,headlabel="0..*",labeldistance=2];
"DemendManger" -> "DemandData" [label="currentDemend",arrowhead=vee,headlabel="0..1",labeldistance=2];
