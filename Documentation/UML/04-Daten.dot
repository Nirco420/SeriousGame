digraph UML {
graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.5", ranksep="1.2", splines=polyline, outputorder=edgesfirst];
node [shape=plain];
edge [fontname="Arial", fontsize=10, color="#64748b", fontcolor="#334155", arrowsize=0.8];
"BuildingData" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#64748b"><TR><TD BGCOLOR="#ede9fe"><FONT FACE="Arial" POINT-SIZE="10">ScriptableObject</FONT><BR/><FONT FACE="Arial" POINT-SIZE="15"><B>BuildingData</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">+ description : string<BR ALIGN="LEFT"/>+ costResource : ResourceData<BR ALIGN="LEFT"/>+ cost : int<BR ALIGN="LEFT"/>+ type : BuildingType<BR ALIGN="LEFT"/>+ resource : ResourceData<BR ALIGN="LEFT"/>+ resourceQuantity : int<BR ALIGN="LEFT"/>+ maxStorage : int<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"BuildingData_BuildingType" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#64748b"><TR><TD BGCOLOR="#f1f5f9"><FONT FACE="Arial" POINT-SIZE="10">enum</FONT><BR/><FONT FACE="Arial" POINT-SIZE="15"><B>BuildingData.BuildingType</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">None<BR ALIGN="LEFT"/>STORAGE<BR ALIGN="LEFT"/>PRODUKTION<BR ALIGN="LEFT"/>RESOURECES<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"DemandData" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#64748b"><TR><TD BGCOLOR="#ede9fe"><FONT FACE="Arial" POINT-SIZE="10">ScriptableObject</FONT><BR/><FONT FACE="Arial" POINT-SIZE="15"><B>DemandData</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">+ name : string<BR ALIGN="LEFT"/>+ description : string<BR ALIGN="LEFT"/>+ resource : ResourceData<BR ALIGN="LEFT"/>+ quantity : int<BR ALIGN="LEFT"/>+ triggerRound : int<BR ALIGN="LEFT"/>+ deadline : int<BR ALIGN="LEFT"/>+ deferralPeriod : int<BR ALIGN="LEFT"/>+ changeInValuePositive : int<BR ALIGN="LEFT"/>+ changeInValueHalf : int<BR ALIGN="LEFT"/>+ changeInValueNegative : int<BR ALIGN="LEFT"/>+ changeInDeferalInValue : int<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"ResourceData" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#64748b"><TR><TD BGCOLOR="#ede9fe"><FONT FACE="Arial" POINT-SIZE="10">ScriptableObject</FONT><BR/><FONT FACE="Arial" POINT-SIZE="15"><B>ResourceData</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">+ resourceType : ResourceType<BR ALIGN="LEFT"/>+ name : string<BR ALIGN="LEFT"/>+ icon : Sprite<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"ResourceData_ResourceType" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#64748b"><TR><TD BGCOLOR="#f1f5f9"><FONT FACE="Arial" POINT-SIZE="10">enum</FONT><BR/><FONT FACE="Arial" POINT-SIZE="15"><B>ResourceData.ResourceType</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">None<BR ALIGN="LEFT"/>WOOD<BR ALIGN="LEFT"/>WHEED<BR ALIGN="LEFT"/>FLACHS<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"BuildingData" -> "BuildingData_BuildingType" [label="type",style=dashed,arrowhead=vee];
"BuildingData" -> "ResourceData" [label="costResource,\nresource",arrowhead=vee];
"DemandData" -> "ResourceData" [label="resource",arrowhead=vee];
"ResourceData" -> "ResourceData_ResourceType" [label="resourceType",style=dashed,arrowhead=vee];
"ScriptableObject" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#64748b"><TR><TD BGCOLOR="#f1f5f9"><FONT FACE="Arial" POINT-SIZE="10">Unity / package</FONT><BR/><FONT FACE="Arial" POINT-SIZE="15"><B>ScriptableObject</B></FONT></TD></TR></TABLE>>];
"BuildingData" -> "ScriptableObject" [arrowhead=empty, color="#0f172a"];
"DemandData" -> "ScriptableObject" [arrowhead=empty, color="#0f172a"];
"ResourceData" -> "ScriptableObject" [arrowhead=empty, color="#0f172a"];
}