digraph UML {
graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.5", ranksep="1.2", splines=polyline, outputorder=edgesfirst];
node [shape=plain];
edge [fontname="Arial", fontsize=10, color="#64748b", fontcolor="#334155", arrowsize=0.8];
"BuildingModel" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#64748b"><TR><TD BGCOLOR="#dcfce7"><FONT FACE="Arial" POINT-SIZE="10">MonoBehaviour</FONT><BR/><FONT FACE="Arial" POINT-SIZE="15"><B>BuildingModel</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">- wrapper : GameObject<BR ALIGN="LEFT"/>- buildingData : BuildingData<BR ALIGN="LEFT"/>+ Data : BuildingData [property]<BR ALIGN="LEFT"/>+ rotation : float<BR ALIGN="LEFT"/>- shapeUnits : BuildingShapeUnit[]<BR ALIGN="LEFT"/>- renderers : Renderer[]<BR ALIGN="LEFT"/>- originalMaterials : Material[][]<BR ALIGN="LEFT"/>- previewMaterial : Material<BR ALIGN="LEFT"/>- production : ResourceProduction<BR ALIGN="LEFT"/>- isPreview : bool<BR ALIGN="LEFT"/>- isPlaced : bool<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">+ Awake() : void<BR ALIGN="LEFT"/>+ BeginPreview() : void<BR ALIGN="LEFT"/>+ SetPreviewMaterial(Material material) : void<BR ALIGN="LEFT"/>+ CompletePlacement(GridManager targetGrid, SegmentStorage<BR ALIGN="LEFT"/>segmentStorage) : bool<BR ALIGN="LEFT"/>+ Rotate(float rotationStep) : void<BR ALIGN="LEFT"/>+ GetAllBuildingPositions() : List&lt;Vector3&gt;<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"MainStorrage" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#64748b"><TR><TD BGCOLOR="#fef3c7"><FONT FACE="Arial" POINT-SIZE="10">MonoBehaviour</FONT><BR/><FONT FACE="Arial" POINT-SIZE="15"><B>MainStorrage</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">+ wood : int [property]<BR ALIGN="LEFT"/>+ wheed : int [property]<BR ALIGN="LEFT"/>+ flachs : int [property]<BR ALIGN="LEFT"/>+ gold : int [property]<BR ALIGN="LEFT"/>- startWood : int<BR ALIGN="LEFT"/>- startWheed : int<BR ALIGN="LEFT"/>- startFlachs : int<BR ALIGN="LEFT"/>- startGold : int<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">+ Start() : void<BR ALIGN="LEFT"/>+ AddResources(int amount, ResourceData resource) : void<BR ALIGN="LEFT"/>+ RemoveResource(int amount, ResourceData resource) : void<BR ALIGN="LEFT"/>+ HasResources(int amount, ResourceData resource) : bool<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"ResourceProduction" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#64748b"><TR><TD BGCOLOR="#fef3c7"><FONT FACE="Arial" POINT-SIZE="10">MonoBehaviour</FONT><BR/><FONT FACE="Arial" POINT-SIZE="15"><B>ResourceProduction</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">- producerForStorage : SegmentStorage<BR ALIGN="LEFT"/>- productionQuantity : int<BR ALIGN="LEFT"/>- producedResource : ResourceData<BR ALIGN="LEFT"/>- displayUI : ResourceDisplayUI<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">+ Setup(BuildingData buildingData, SegmentStorage segmentStorage) :<BR ALIGN="LEFT"/>void<BR ALIGN="LEFT"/>+ ProduceResource() : void<BR ALIGN="LEFT"/>+ OnDestroy() : void<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"SegmentStorage" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#64748b"><TR><TD BGCOLOR="#fef3c7"><FONT FACE="Arial" POINT-SIZE="10">MonoBehaviour</FONT><BR/><FONT FACE="Arial" POINT-SIZE="15"><B>SegmentStorage</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">- buildingData : BuildingData<BR ALIGN="LEFT"/>+ storedResource : ResourceData [property]<BR ALIGN="LEFT"/>- resourceBuildings : List&lt;ResourceProduction&gt;<BR ALIGN="LEFT"/>+ currentAmount : int [property]<BR ALIGN="LEFT"/>+ maxCapacity : int [property]<BR ALIGN="LEFT"/>+ assignedCarts : int [property]<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">+ Awake() : void<BR ALIGN="LEFT"/>+ AddResources(int amount) : void<BR ALIGN="LEFT"/>+ RemoveResources(int amount) : int<BR ALIGN="LEFT"/>+ RegisterProducer(ResourceProduction productionBuilding) : void<BR ALIGN="LEFT"/>+ RemoveProducer(ResourceProduction productionBuilding) : void<BR ALIGN="LEFT"/>+ ProducePerRound() : void<BR ALIGN="LEFT"/>+ AssignCart() : bool<BR ALIGN="LEFT"/>+ RemoveCarts() : bool<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"DemendManger" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#64748b"><TR><TD BGCOLOR="#fce7f3"><FONT FACE="Arial" POINT-SIZE="10">MonoBehaviour</FONT><BR/><FONT FACE="Arial" POINT-SIZE="15"><B>DemendManger</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">+ OnDemandDisplayRequested : Action&lt;DemandData, int&gt; [event]<BR ALIGN="LEFT"/>+ OnDemandCompleted : Action [event]<BR ALIGN="LEFT"/>- demands : List&lt;DemandData&gt;<BR ALIGN="LEFT"/>- mainStorrage : MainStorrage<BR ALIGN="LEFT"/>- barometerManager : BarometerManager<BR ALIGN="LEFT"/>- currentDemend : DemandData<BR ALIGN="LEFT"/>- nextDemandIndex : int<BR ALIGN="LEFT"/>- dueRound : int<BR ALIGN="LEFT"/>- latestRound : int<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">+ TriggerDemand(DemandData demand, int currentRound) : void<BR ALIGN="LEFT"/>+ CheckDemandsForRound(int currentRound) : void<BR ALIGN="LEFT"/>+ GiveAll() : void<BR ALIGN="LEFT"/>+ GiveHalf() : void<BR ALIGN="LEFT"/>+ MoreTime() : void<BR ALIGN="LEFT"/>+ HasActiveDemand() : bool<BR ALIGN="LEFT"/>+ CanGiveAll() : bool<BR ALIGN="LEFT"/>+ CanGiveHalf() : bool<BR ALIGN="LEFT"/>- CompleteDemand() : void<BR ALIGN="LEFT"/>+ GetRemainingRounds() : int<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"RoundManager" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#64748b"><TR><TD BGCOLOR="#e0f2fe"><FONT FACE="Arial" POINT-SIZE="10">MonoBehaviour</FONT><BR/><FONT FACE="Arial" POINT-SIZE="15"><B>RoundManager</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">- ui : BuildingUI<BR ALIGN="LEFT"/>- storages : List&lt;SegmentStorage&gt;<BR ALIGN="LEFT"/>- demendManger : DemendManger<BR ALIGN="LEFT"/>+ currentRound : int [property]<BR ALIGN="LEFT"/>- transports : List&lt;TransportManager&gt;<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">- OnEnable() : void<BR ALIGN="LEFT"/>+ StartNextRound(bool isRoundFinished) : void<BR ALIGN="LEFT"/>- OnDisable() : void<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"InputManager" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#64748b"><TR><TD BGCOLOR="#e0f2fe"><FONT FACE="Arial" POINT-SIZE="10">MonoBehaviour</FONT><BR/><FONT FACE="Arial" POINT-SIZE="15"><B>InputManager</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">+ OnFingerMoved : Action&lt;Vector2&gt; [event]<BR ALIGN="LEFT"/>+ OnFingerBegan : Action&lt;Vector2&gt; [event]<BR ALIGN="LEFT"/>+ OnFingerEnded : Action&lt;Vector2&gt; [event]<BR ALIGN="LEFT"/>+ OnSwipe : Action&lt;int&gt; [event]<BR ALIGN="LEFT"/>+ OnTap : Action&lt;Vector2&gt; [event]<BR ALIGN="LEFT"/>- swipeRange : float<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">- OnEnable() : void<BR ALIGN="LEFT"/>- Update() : void<BR ALIGN="LEFT"/>+ TrackFingerPosition(Touch touch) : Vector2<BR ALIGN="LEFT"/>+ TrackFingerStartPosition(Touch touch) : Vector2<BR ALIGN="LEFT"/>+ TrackFingerEndPosition(Touch touch) : Vector2<BR ALIGN="LEFT"/>+ OnDisable() : void<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"BuildingData" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#64748b"><TR><TD BGCOLOR="#ede9fe"><FONT FACE="Arial" POINT-SIZE="10">ScriptableObject</FONT><BR/><FONT FACE="Arial" POINT-SIZE="15"><B>BuildingData</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">+ description : string<BR ALIGN="LEFT"/>+ costResource : ResourceData<BR ALIGN="LEFT"/>+ cost : int<BR ALIGN="LEFT"/>+ type : BuildingType<BR ALIGN="LEFT"/>+ resource : ResourceData<BR ALIGN="LEFT"/>+ resourceQuantity : int<BR ALIGN="LEFT"/>+ maxStorage : int<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"ResourceData" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#64748b"><TR><TD BGCOLOR="#ede9fe"><FONT FACE="Arial" POINT-SIZE="10">ScriptableObject</FONT><BR/><FONT FACE="Arial" POINT-SIZE="15"><B>ResourceData</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">+ resourceType : ResourceType<BR ALIGN="LEFT"/>+ name : string<BR ALIGN="LEFT"/>+ icon : Sprite<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"CartManager" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#64748b"><TR><TD BGCOLOR="#fef3c7"><FONT FACE="Arial" POINT-SIZE="10">MonoBehaviour</FONT><BR/><FONT FACE="Arial" POINT-SIZE="15"><B>CartManager</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">- totalCarts : int<BR ALIGN="LEFT"/>+ TotalCarts : int [property]<BR ALIGN="LEFT"/>+ availableCarts : int [property]<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">- Awake() : void<BR ALIGN="LEFT"/>+ AssignCart(SegmentStorage storage) : bool<BR ALIGN="LEFT"/>+ RemoveCart(SegmentStorage storage) : bool<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"TransportManager" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#64748b"><TR><TD BGCOLOR="#fef3c7"><FONT FACE="Arial" POINT-SIZE="10">MonoBehaviour</FONT><BR/><FONT FACE="Arial" POINT-SIZE="15"><B>TransportManager</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">- segmentStorage : SegmentStorage<BR ALIGN="LEFT"/>- mainStorage : MainStorrage<BR ALIGN="LEFT"/>- startStoragPos : Transform<BR ALIGN="LEFT"/>- mainStoragePos : Transform<BR ALIGN="LEFT"/>- cart : GameObject<BR ALIGN="LEFT"/>- splineAnimate : SplineAnimate<BR ALIGN="LEFT"/>- resourceDisplayUI : ResourceDisplayUI<BR ALIGN="LEFT"/>- transportCapacity : int<BR ALIGN="LEFT"/>+ currentLoad : int [property]<BR ALIGN="LEFT"/>+ moveSpeed : float<BR ALIGN="LEFT"/>- isDriving : bool<BR ALIGN="LEFT"/>+ resourceData : ResourceData [property]<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">- Update() : void<BR ALIGN="LEFT"/>+ StartTransport() : void<BR ALIGN="LEFT"/>+ MoveToMainStorage(float kmh) : IEnumerator<BR ALIGN="LEFT"/>+ MoveBackToSegmentStorage(float kmh) : IEnumerator<BR ALIGN="LEFT"/>+ TranportLifeCycle(Transform startPos, Transform targetPos, float<BR ALIGN="LEFT"/>kmh) : IEnumerator<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"BuildingUI" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#64748b"><TR><TD BGCOLOR="#e0f2fe"><FONT FACE="Arial" POINT-SIZE="10">MonoBehaviour</FONT><BR/><FONT FACE="Arial" POINT-SIZE="15"><B>BuildingUI</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">+ OnBuildingSelected : Action&lt;BuildingModel&gt; [event]<BR ALIGN="LEFT"/>+ OnNextRoundPressed : Action&lt;bool&gt; [event]<BR ALIGN="LEFT"/>- buildingButton : Button<BR ALIGN="LEFT"/>- buildingPanel : GameObject<BR ALIGN="LEFT"/>- segmentRotation : SegmentRotation<BR ALIGN="LEFT"/>- building1 : Button<BR ALIGN="LEFT"/>- building2 : Button<BR ALIGN="LEFT"/>- building3 : Button<BR ALIGN="LEFT"/>- nextRound : Button<BR ALIGN="LEFT"/>- building1x1 : BuildingModel<BR ALIGN="LEFT"/>- building2x2 : BuildingModel<BR ALIGN="LEFT"/>- building3x3 : BuildingModel<BR ALIGN="LEFT"/>- text1x1Building : TextMeshProUGUI<BR ALIGN="LEFT"/>- text2x2Building : TextMeshProUGUI<BR ALIGN="LEFT"/>- text3x3Building : TextMeshProUGUI<BR ALIGN="LEFT"/>- resourceImage1x1 : Image<BR ALIGN="LEFT"/>- resourceImage2x2 : Image<BR ALIGN="LEFT"/>- resourceImage3x3 : Image<BR ALIGN="LEFT"/>- wheedBuilding : BuildingModel<BR ALIGN="LEFT"/>- woodBuilding : BuildingModel<BR ALIGN="LEFT"/>- flachsBuilding : BuildingModel<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">+ Start() : void<BR ALIGN="LEFT"/>+ OnBuildingButtonClicked() : void<BR ALIGN="LEFT"/>+ BuildingFinished() : void<BR ALIGN="LEFT"/>+ OnBuilding1Clicked() : void<BR ALIGN="LEFT"/>+ OnBuilding2Clicked() : void<BR ALIGN="LEFT"/>+ OnBuilding3Clicked() : void<BR ALIGN="LEFT"/>+ OnEndRoundWasClicked() : void<BR ALIGN="LEFT"/>+ ShowCostBuilding(BuildingData buildingData, TextMeshProUGUI text,<BR ALIGN="LEFT"/>Image image) : void<BR ALIGN="LEFT"/>+ RefreshUiButtons() : void<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"ResourceDisplayUI" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#64748b"><TR><TD BGCOLOR="#f1f5f9"><FONT FACE="Arial" POINT-SIZE="10">MonoBehaviour</FONT><BR/><FONT FACE="Arial" POINT-SIZE="15"><B>ResourceDisplayUI</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">- resourceIcon : Image<BR ALIGN="LEFT"/>- quantity : TextMeshProUGUI<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">+ SetResource(ResourceData resource) : void<BR ALIGN="LEFT"/>+ SetQuantity(int amount) : void<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"SegmentStorageUI" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#64748b"><TR><TD BGCOLOR="#f1f5f9"><FONT FACE="Arial" POINT-SIZE="10">MonoBehaviour</FONT><BR/><FONT FACE="Arial" POINT-SIZE="15"><B>SegmentStorageUI</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">- segmentStorageUi : GameObject<BR ALIGN="LEFT"/>- resourceImage : Image<BR ALIGN="LEFT"/>- amountText : TextMeshProUGUI<BR ALIGN="LEFT"/>- closeButton : Button<BR ALIGN="LEFT"/>- cartManager : CartManager<BR ALIGN="LEFT"/>- panelOffset : Vector3<BR ALIGN="LEFT"/>- inputManager : InputManager<BR ALIGN="LEFT"/>- mainCamera : Camera<BR ALIGN="LEFT"/>- cartSlot1 : Button<BR ALIGN="LEFT"/>- cartSlot2 : Button<BR ALIGN="LEFT"/>- cartSlot3 : Button<BR ALIGN="LEFT"/>- slotEmpty : Sprite<BR ALIGN="LEFT"/>- slotFull : Sprite<BR ALIGN="LEFT"/>- segmentStorage : SegmentStorage<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="11">+ OnEnable() : void<BR ALIGN="LEFT"/>+ Start() : void<BR ALIGN="LEFT"/>+ OpenUI(Vector2 pos) : void<BR ALIGN="LEFT"/>+ CloseUI() : void<BR ALIGN="LEFT"/>- GetStorageAtPosition(Vector2 pos) : SegmentStorage<BR ALIGN="LEFT"/>- ToggleCart(int slot) : void<BR ALIGN="LEFT"/>- RefreshCartButtons() : void<BR ALIGN="LEFT"/>+ OnDisable() : void<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
